    "@types/react-dom": "^19.1.6",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "~0.28.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.20.5"
  },
  "volta": {
    "node": "20.19.2",
    "pnpm": "10.12.1"
