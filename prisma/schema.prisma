generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model City {
  id         String @id @map("code")
  name       String
  prefecture String

  @@map("cities")
}

model Shelter {
  id               String           @id @map("code")
  name             String
  cityId           String           @map("city_code")
  cityName         String           @map("city_name")
  prefecture       String
  address          String
  latitude         Float
  longitude        Float
  elevatorInfo     String?          @map("elevator_info")
  slope            String?
  brailleBlocks    String?          @map("braille_blocks")
  wheelchairToilet String?          @map("wheelchair_toilet")
  otherFacilities  String?          @map("other_facilities")
  status           String
  created          DateTime         @default(now())
  updated          DateTime         @default(now()) @updatedAt
  evacuees         ShelterEvacuee[]
  supplies         ShelterSupply[]

  @@map("shelters")
}

model Evacuee {
  id           String           @id @map("my_number")
  familyName   String           @map("family_name")
  givenName    String           @map("given_name")
  gender       String
  birthDate    String           @map("birth_date")
  address      String
  phoneNumber  String           @map("phone_number")
  healthStatus String?          @map("health_status")
  specialNotes String?          @map("special_notes")
  created      DateTime         @default(now())
  updated      DateTime         @default(now()) @updatedAt
  shelters     ShelterEvacuee[]

  @@map("evacuees")
}

model ShelterEvacuee {
  shelterId String   @map("shelter_code")
  evacueeId String   @map("my_number")
  created   DateTime @default(now())
  updated   DateTime @default(now()) @updatedAt
  shelter   Shelter  @relation(fields: [shelterId], references: [id])
  evacuee   Evacuee  @relation(fields: [evacueeId], references: [id])

  @@id([shelterId, evacueeId])
  @@map("shelter_evacuees")
}

model Supply {
  id             String          @id
  name           String
  category       String?
  expirationDate String?         @map("expiration_date")
  created        DateTime        @default(now())
  updated        DateTime        @default(now()) @updatedAt
  shelters       ShelterSupply[]

  @@map("supplies")
}

model ShelterSupply {
  shelterId String   @map("shelter_code")
  supplyId  String   @map("supply_id")
  quantity  Int
  created   DateTime @default(now())
  updated   DateTime @default(now()) @updatedAt
  shelter   Shelter  @relation(fields: [shelterId], references: [id])
  supply    Supply   @relation(fields: [supplyId], references: [id])

  @@id([shelterId, supplyId])
  @@map("shelter_supplies")
}
